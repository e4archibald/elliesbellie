---
import Base from '../../layouts/Base.astro';
import Table from '../../components/Table.astro';
import Scribble from '../../components/Scribble.astro';
import { CATEGORIES, categoryBySlug } from '../../data/categories';
import { allEntries } from '../../lib/entries';
import { url, shortDate } from '../../lib/site';

export async function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.slug } }));
}

const { category: slug } = Astro.params;
const category = categoryBySlug(slug!)!;
const index = CATEGORIES.findIndex((c) => c.slug === slug);
const numeral = String(index + 1).padStart(2, '0');

const all = await allEntries();
const entries = all.filter((e) => e.data.category === slug);
const others = CATEGORIES.filter((c) => c.slug !== slug);
const countIn = (s: string) => all.filter((e) => e.data.category === s).length;
---

<Base title={category.label} description={category.blurb}>
  <header class="wrap head">
    <p class="kicker">{numeral} of 05</p>
    <h1>{category.label}</h1>
    <Scribble />
    <p class="hand blurb">{category.blurb}</p>
    <p class="mono stat">
      {entries.length} {entries.length === 1 ? 'ITEM' : 'ITEMS'}
      {entries[0] && <><span class="dot" aria-hidden="true">·</span>LAST ADDED {shortDate(entries[0].data.date)}</>}
    </p>
  </header>

  {
    entries.length > 0 ? (
      <Table entries={entries} heading="On the table" />
    ) : (
      <p class="wrap hand empty">Nothing filed here yet.</p>
    )
  }

  <nav class="wrap siblings" aria-labelledby="sib-h">
    <h2 class="hand label" id="sib-h">the other four</h2>
    <ul>
      {
        others.map((c) => (
          <li>
            <a href={url(`/c/${c.slug}/`)}>
              <span class="sib-name">{c.label}</span>
              <span class="sib-count mono">{String(countIn(c.slug)).padStart(2, '0')}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</Base>

<style>
  .head {
    padding-top: clamp(28px, 5vw, 46px);
  }
  .kicker {
    margin: 0 0 var(--s4);
  }
  h1 {
    font-size: clamp(34px, 5vw, 56px);
    line-height: 1.02;
  }
  .blurb {
    margin: var(--s4) 0 0;
    max-width: 34ch;
    rotate: -1deg;
  }
  .stat {
    margin: var(--s5) 0 0;
    font-size: 10.5px;
    letter-spacing: 0.13em;
    color: var(--text-3);
  }
  .dot {
    margin-inline: 8px;
  }

  .empty {
    margin-top: var(--section);
    font-weight: 600;
  }

  /* A collection page should not be a dead end. */
  .siblings {
    margin-top: var(--section);
  }
  .label {
    margin: 0 0 var(--s2);
    font-size: 28px;
    font-weight: 600;
  }
  .siblings ul {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 720px;
  }
  .siblings li {
    border-bottom: 1px dashed var(--rule);
  }
  .siblings a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s4);
    padding: var(--s4) var(--s2);
    transition: translate 0.35s var(--ease);
  }
  .siblings a:hover {
    translate: 6px 0;
  }
  .sib-name {
    font-family: var(--font-serif), Georgia, serif;
    font-size: clamp(21px, 2.3vw, 26px);
    line-height: 1.15;
    transition: color 0.25s;
  }
  .siblings a:hover .sib-name {
    color: var(--accent);
  }
  .sib-count {
    font-size: 10.5px;
    letter-spacing: 0.13em;
    color: var(--text-3);
  }
</style>
