---
import Base from '../layouts/Base.astro';
import Scribble from '../components/Scribble.astro';
import { url } from '../lib/site';
---

<Base title="Not found">
  <div class="wrap page">
    <p class="kicker">404</p>
    <h1>Filed somewhere else, or not at all.</h1>
    <Scribble />
    <p class="hand body">
      <a class="u-link" href={url('/log/')}>try the log</a> — everything is in there, newest first.
    </p>
  </div>
</Base>

<style>
  .page {
    padding-top: clamp(40px, 8vw, 90px);
    padding-bottom: clamp(40px, 8vw, 90px);
    max-width: 640px;
  }
  .kicker {
    margin: 0 0 16px;
  }
  h1 {
    font-size: clamp(34px, 5vw, 56px);
    line-height: 1.02;
  }
  .body {
    margin-top: 24px;
    rotate: -1.5deg;
  }
</style>
