---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Frame from '../../components/Frame.astro';
import { allEntries, type Entry } from '../../lib/entries';
import { categoryBySlug } from '../../data/categories';
import { url, longDate, isoDate } from '../../lib/site';

export async function getStaticPaths() {
  const entries = await getCollection('log');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: Entry };
const { Content } = await render(entry);
const category = categoryBySlug(entry.data.category);
const { image, imageAlt, gallery } = entry.data;

// A gallery is laid out in one row, each image given width in proportion to
// its own shape so that they all come out the same height. The flex-grow is
// that proportion as a whole number: a flex-grow total below 1 would leave
// part of the row empty, which a single portrait (0.7) on its own would do.
const plates = (gallery ?? []).map((plate) => ({
  ...plate,
  ratio: plate.image.width / plate.image.height,
}));
const rowRatio = plates.reduce((sum, plate) => sum + plate.ratio, 0);

// Previous / next by date, so an entry is never a dead end.
const all = await allEntries();
const i = all.findIndex((e) => e.id === entry.id);
const newer = i > 0 ? all[i - 1] : undefined;
const older = i >= 0 && i < all.length - 1 ? all[i + 1] : undefined;
---

<Base title={entry.data.title} description={entry.data.blurb}>
  <article class="entry">
    <header class="wrap entry-head">
      <p class="kicker">{entry.data.kicker}</p>
      <h1>{entry.data.title}</h1>
      <p class="blurb">{entry.data.blurb}</p>
      <p class="meta mono">
        <time datetime={isoDate(entry.data.date)}>{longDate(entry.data.date)}</time>
        <span aria-hidden="true">·</span>
        <a href={url(`/c/${entry.data.category}/`)}>{category?.name ?? entry.data.category}</a>
      </p>
    </header>

    {
      plates.length > 0 ? (
        <div class="wrap figure">
          <div class="plates" style={`--row:${rowRatio.toFixed(4)}; --gaps:${plates.length - 1}`}>
            {plates.map((plate, i) => (
              <figure
                class="plate"
                style={`--r:${plate.ratio.toFixed(4)}; --grow:${Math.round(plate.ratio * 1000)}`}
              >
                <Frame
                  image={plate.image}
                  alt={plate.alt}
                  category={entry.data.category}
                  tone="paper"
                  widths={[400, 640, 960, 1280]}
                  sizes="(max-width: 620px) 92vw, (max-width: 1100px) 46vw, 500px"
                />
                {plate.caption && (
                  <figcaption class="mono">
                    <span class="plate-n">{String(i + 1).padStart(2, '0')}</span>
                    {plate.caption}
                  </figcaption>
                )}
              </figure>
            ))}
          </div>
        </div>
      ) : (
        image && (
          <figure class:list={['wrap figure', { 'figure--tall': image.height > image.width }]}>
            <Frame
              image={image}
              alt={imageAlt ?? ''}
              category={entry.data.category}
              ratio="16 / 9"
              tone="paper"
              widths={[720, 1100, 1600]}
              sizes="(max-width: 1100px) 92vw, 1012px"
            />
          </figure>
        )
      )
    }

    <div class="wrap prose">
      <Content />
    </div>

    <div class="wrap filed">
      <span class="mono filed-label">FILED UNDER</span>
      <a class="filed-cat" href={url(`/c/${entry.data.category}/`)}>
        {category?.label ?? entry.data.category}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </article>

  <nav class="wrap pager" aria-label="More entries">
    {
      older ? (
        <a class="pager-link" href={url(`/log/${older.id}/`)}>
          <span class="mono">← OLDER</span>
          <span class="pager-title">{older.data.title}</span>
        </a>
      ) : (
        <span />
      )
    }
    {
      newer && (
        <a class="pager-link pager-next" href={url(`/log/${newer.id}/`)}>
          <span class="mono">NEWER →</span>
          <span class="pager-title">{newer.data.title}</span>
        </a>
      )
    }
  </nav>
</Base>

<style>
  /* One column, one left edge. The figure is deliberately the exception —
     a photograph gets the full width. */
  .entry-head,
  .prose,
  .pager {
    max-width: 720px;
  }

  .entry-head {
    padding-top: clamp(28px, 5vw, 48px);
  }
  .entry-head .kicker {
    margin: 0 0 14px;
  }
  h1 {
    font-size: clamp(34px, 5.4vw, 58px);
    line-height: 1.02;
  }
  .blurb {
    margin: 18px 0 0;
    max-width: 52ch;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-3);
  }
  .meta {
    margin: 20px 0 0;
    display: flex;
    gap: 10px;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--text-3);
  }
  .meta a:hover {
    color: var(--accent);
  }

  .figure {
    /* About one screen: the most a portrait or a gallery is allowed to be. */
    --fit-h: 80svh;
    margin: clamp(26px, 4vw, 44px) auto 0;
  }
  .figure :global(.frame) {
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--rule);
  }
  /* A portrait — a drawing, a vertical frame — at the full width would run
     two screens down the page, so it narrows and centres until it fits on
     one. Landscape photographs keep the full width. --ratio is the frame's
     own "width / height", so this is fit-h × w ÷ h. */
  .figure--tall > :global(.frame) {
    width: min(100%, calc(var(--fit-h) * var(--ratio)));
    margin-inline: auto;
  }

  /* A gallery: one row, each image as wide as its shape asks for (--grow,
     set above), so they share a height and their captions line up. The row
     as a whole keeps to the same one-screen limit. */
  .plates {
    display: flex;
    align-items: flex-start;
    gap: var(--s5);
    max-width: calc(var(--fit-h) * var(--row) + var(--s5) * var(--gaps));
    margin-inline: auto;
  }
  .plate {
    flex: var(--grow) 1 0;
    min-width: 0;
    margin: 0;
  }
  .plate figcaption {
    margin-top: 12px;
    font-size: 10px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .plate-n {
    margin-right: 10px;
    font-weight: 500;
    color: var(--accent);
  }

  .prose {
    margin-top: clamp(26px, 4vw, 44px);
    font-size: 16.5px;
    line-height: 1.75;
    color: var(--text);
  }
  .prose :global(p) {
    margin: 0 0 1.15em;
  }

  /* One drop cap, on the first paragraph only. The serif is the voice of
     this site; the essays should open in it. */
  .prose :global(> p:first-of-type::first-letter) {
    float: left;
    font-family: var(--font-serif), Georgia, serif;
    font-size: 3.5em;
    line-height: 0.82;
    padding: 0.06em 0.09em 0 0;
    color: var(--ink);
  }
  .prose :global(h2) {
    margin: 1.9em 0 0.5em;
    font-size: 28px;
    line-height: 1.15;
  }
  .prose :global(h3) {
    margin: 1.6em 0 0.4em;
    font-size: 21px;
  }
  .prose :global(a) {
    color: var(--accent);
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 1.08em;
    background-size: 100% 1px;
    transition: background-size 0.3s var(--ease), color 0.25s;
  }
  .prose :global(a:hover),
  .prose :global(a:focus-visible) {
    color: var(--accent-hover);
    background-size: 0% 1px;
  }
  .prose :global(blockquote) {
    margin: 1.6em 0;
    padding-left: 20px;
    border-left: 2px solid var(--accent);
    font-family: var(--font-serif), Georgia, serif;
    font-size: 21px;
    line-height: 1.4;
    color: var(--text-2);
  }
  .prose :global(blockquote p) {
    margin: 0;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.15em;
    padding-left: 1.3em;
  }
  .prose :global(li) {
    margin-bottom: 0.35em;
  }
  .prose :global(hr) {
    margin: 2.2em 0;
    border: 0;
    border-top: 1px solid var(--rule);
  }
  .prose :global(code) {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 0.86em;
    background: rgb(var(--ink-rgb) / 7%);
    padding: 0.15em 0.4em;
    border-radius: 4px;
  }
  .prose :global(img) {
    border-radius: 10px;
    margin: 1.6em 0;
  }

  .filed {
    margin-top: var(--s7);
    padding-top: var(--s4);
    max-width: 720px;
    border-top: 1px solid var(--rule);
    display: flex;
    align-items: baseline;
    gap: var(--s4);
    flex-wrap: wrap;
  }
  .filed-label {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.16em;
    color: var(--text-3);
  }
  .filed-cat {
    display: inline-flex;
    gap: 8px;
    font-family: var(--font-serif), Georgia, serif;
    font-size: 21px;
    color: var(--ink);
    transition: color 0.25s;
  }
  .filed-cat:hover {
    color: var(--accent);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: clamp(40px, 6vw, 70px);
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 20px;
    border: 1px solid var(--rule);
    border-radius: 12px;
    transition: border-color 0.3s, transform 0.3s var(--ease);
  }
  .pager-link:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
  }
  .pager-next {
    text-align: right;
    align-items: flex-end;
  }
  .pager-link .mono {
    font-size: 10px;
    letter-spacing: 0.13em;
    color: var(--text-3);
  }
  .pager-title {
    font-family: var(--font-serif), Georgia, serif;
    font-size: 19px;
    line-height: 1.2;
  }

  @media (max-width: 620px) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pager-next {
      text-align: left;
      align-items: flex-start;
    }

    /* On a phone, one above the other: side by side, each would be too
       small to make out a pencil line. */
    .plates {
      flex-direction: column;
      gap: var(--s6);
      max-width: none;
    }
    .plate {
      flex: none;
      width: min(100%, calc(var(--fit-h) * var(--r)));
      margin-inline: auto;
    }
  }
</style>
