---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Frame from '../../components/Frame.astro';
import Scribble from '../../components/Scribble.astro';
import { allEntries, tilt, type Entry } from '../../lib/entries';
import { categoryBySlug } from '../../data/categories';
import { url, longDate, isoDate } from '../../lib/site';

export async function getStaticPaths() {
  const entries = await getCollection('log');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: Entry };
const { Content } = await render(entry);
const category = categoryBySlug(entry.data.category);
const { image, imageAlt, gallery } = entry.data;

// A gallery is laid out in rows of two, each image given width in proportion
// to its own shape so that the pair come out the same height. Two stages of a
// drawing sit side by side; a longer run of frames goes two to a row, because
// four in one row would each be too small to look at. The flex-grow is that
// proportion as a whole number: a flex-grow total below 1 would leave part of
// the row empty, which a single portrait (0.7) on its own would do.
const PER_ROW = 2;
const plates = (gallery ?? []).map((plate, i) => ({
  ...plate,
  n: i + 1,
  ratio: plate.image.width / plate.image.height,
  lie: `--r:${tilt(entry.id, 2.5, `plate${i}`)}deg; --tr:${tilt(entry.id, 5, `tape${i}`)}deg`,
}));
const rows = [];
for (let r = 0; r < plates.length; r += PER_ROW) {
  const row = plates.slice(r, r + PER_ROW);
  rows.push({ plates: row, ratio: row.reduce((sum, plate) => sum + plate.ratio, 0) });
}

// Previous / next by date, so an entry is never a dead end.
const all = await allEntries();
const i = all.findIndex((e) => e.id === entry.id);
const newer = i > 0 ? all[i - 1] : undefined;
const older = i >= 0 && i < all.length - 1 ? all[i + 1] : undefined;
---

<Base title={entry.data.title} description={entry.data.blurb}>
  <article class="entry">
    <header class="wrap entry-head">
      <p class="kicker">{entry.data.kicker}</p>
      <h1>{entry.data.title}</h1>
      <Scribble />
      <p class="hand blurb">{entry.data.blurb}</p>
      <p class="meta mono">
        <time datetime={isoDate(entry.data.date)}>{longDate(entry.data.date)}</time>
        <span aria-hidden="true">·</span>
        <a href={url(`/c/${entry.data.category}/`)}>{category?.name ?? entry.data.category}</a>
      </p>
    </header>

    {
      plates.length > 0 ? (
        <div class="wrap figure rows">
          {rows.map((row) => (
            <div
              class:list={['plates', { 'plates--lone': row.plates.length < PER_ROW && rows.length > 1 }]}
              style={`--row:${row.ratio.toFixed(4)}; --gaps:${row.plates.length - 1}`}
            >
              {row.plates.map((plate) => (
                <figure
                  class="plate"
                  style={`--r-plate:${plate.ratio.toFixed(4)}; --grow:${Math.round(plate.ratio * 1000)}`}
                >
                  <div class="print" style={plate.lie}>
                    <Frame
                      image={plate.image}
                      alt={plate.alt}
                      category={entry.data.category}
                      widths={[400, 640, 960, 1280]}
                      sizes="(max-width: 620px) 92vw, (max-width: 1100px) 46vw, 500px"
                      loading={plate.n <= PER_ROW ? 'eager' : 'lazy'}
                    />
                  </div>
                  {plate.caption && (
                    <figcaption class="hand">
                      <span class="plate-n mono">{String(plate.n).padStart(2, '0')}</span>
                      {plate.caption}
                    </figcaption>
                  )}
                </figure>
              ))}
            </div>
          ))}
        </div>
      ) : (
        image && (
          <figure class:list={['wrap figure', { 'figure--tall': image.height > image.width }]}>
            <div
              class="print"
              style={`--r:${tilt(entry.id, 1.5)}deg; --tr:${tilt(entry.id, 5, 'tape')}deg; --ratio:${image.width} / ${image.height}`}
            >
              <Frame
                image={image}
                alt={imageAlt ?? ''}
                category={entry.data.category}
                widths={[720, 1100, 1600]}
                sizes="(max-width: 1100px) 92vw, 1012px"
                loading="eager"
              />
            </div>
          </figure>
        )
      )
    }

    <div class="wrap prose">
      <Content />
    </div>

    <div class="wrap filed">
      <span class="hand filed-label">filed under</span>
      <a class="filed-cat" href={url(`/c/${entry.data.category}/`)}>
        {category?.label ?? entry.data.category}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </article>

  <nav class="wrap pager" aria-label="More entries">
    {
      older ? (
        <a class="pager-link print" href={url(`/log/${older.id}/`)} style={`--r:${tilt(older.id, 2)}deg`}>
          <span class="hand">← older</span>
          <span class="pager-title">{older.data.title}</span>
        </a>
      ) : (
        <span />
      )
    }
    {
      newer && (
        <a class="pager-link pager-next print" href={url(`/log/${newer.id}/`)} style={`--r:${tilt(newer.id, 2)}deg`}>
          <span class="hand">newer →</span>
          <span class="pager-title">{newer.data.title}</span>
        </a>
      )
    }
  </nav>
</Base>

<style>
  /* One column, one left edge. The figure is deliberately the exception —
     a picture gets the full width. */
  .entry-head,
  .prose,
  .filed,
  .pager {
    max-width: 720px;
  }

  .entry-head {
    padding-top: clamp(28px, 5vw, 48px);
  }
  .entry-head .kicker {
    margin: 0 0 14px;
  }
  h1 {
    font-size: clamp(36px, 5.6vw, 60px);
    line-height: 1.02;
  }
  /* The blurb is pencilled beside the title, in the writer's own voice. */
  .blurb {
    margin: 18px 0 0;
    max-width: 34ch;
    rotate: -1deg;
  }
  .meta {
    margin: 20px 0 0;
    display: flex;
    gap: 10px;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--text-3);
  }
  .meta a:hover {
    color: var(--accent);
  }

  .figure {
    /* About one screen: the most a portrait or a gallery is allowed to be. */
    --fit-h: 78svh;
    margin: clamp(34px, 5vw, 56px) auto 0;
  }
  /* A portrait — a drawing, a vertical frame — at the full width would run
     two screens down the page, so it narrows and centres until it fits on
     one. Landscape pictures keep the full width. */
  .figure--tall > .print {
    width: min(100%, calc(var(--fit-h) * var(--ratio)));
    margin-inline: auto;
  }

  /* A gallery: rows of two, each print as wide as its shape asks for (--grow,
     set above), so a pair share a height and their captions line up. */
  .rows {
    display: flex;
    flex-direction: column;
    gap: var(--s7);
  }
  .plates {
    width: 100%;
    display: flex;
    align-items: flex-start;
    gap: var(--s6);
    max-width: calc(var(--fit-h) * var(--row) + var(--s6) * var(--gaps));
    margin-inline: auto;
  }
  /* The odd one out at the end of a run keeps the size of its neighbours
     above instead of filling the whole row. */
  .plates.plates--lone {
    width: calc((100% - var(--s6)) / 2);
  }
  .plate {
    flex: var(--grow) 1 0;
    min-width: 0;
    margin: 0;
  }
  .plate figcaption {
    margin-top: 16px;
    font-weight: 600;
    text-transform: lowercase;
  }
  .plate-n {
    margin-right: 10px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
  }

  .prose {
    margin-top: clamp(30px, 4.5vw, 52px);
    font-size: 17px;
    line-height: 1.75;
    color: var(--text);
  }
  .prose :global(p) {
    margin: 0 0 1.15em;
  }

  /* One drop cap, on the first paragraph only. The serif is the voice of
     this site; the essays should open in it. */
  .prose :global(> p:first-of-type::first-letter) {
    float: left;
    font-family: var(--font-serif), Georgia, serif;
    font-size: 3.5em;
    line-height: 0.82;
    padding: 0.06em 0.09em 0 0;
    color: var(--ink);
  }
  .prose :global(h2) {
    margin: 1.9em 0 0.5em;
    font-size: 30px;
    line-height: 1.15;
  }
  .prose :global(h3) {
    margin: 1.6em 0 0.4em;
    font-size: 22px;
  }
  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .prose :global(a:hover),
  .prose :global(a:focus-visible) {
    color: var(--accent-hover);
    text-decoration-style: wavy;
  }
  /* A quotation is written into the margin in pen. */
  .prose :global(blockquote) {
    margin: 1.6em 0;
    padding-left: 22px;
    border-left: 2px solid var(--accent);
    font-family: var(--font-hand), cursive;
    font-weight: 500;
    font-size: 27px;
    line-height: 1.25;
    color: var(--accent);
  }
  .prose :global(blockquote p) {
    margin: 0;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.15em;
    padding-left: 1.3em;
  }
  .prose :global(li) {
    margin-bottom: 0.35em;
  }
  .prose :global(hr) {
    margin: 2.2em 0;
    border: 0;
    border-top: 1px dashed var(--rule);
  }
  .prose :global(code) {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 0.86em;
    background: rgb(var(--ink-rgb) / 7%);
    padding: 0.15em 0.4em;
    border-radius: 4px;
  }
  .prose :global(img) {
    margin: 1.6em 0;
    padding: 8px;
    background: var(--print);
    box-shadow: var(--lift);
  }

  .filed {
    position: relative;
    margin-top: var(--s7);
    padding-top: var(--s4);
    display: flex;
    align-items: baseline;
    gap: var(--s4);
    flex-wrap: wrap;
  }
  /* The rule spans the text column, not the padding either side of it. */
  .filed::before {
    content: '';
    position: absolute;
    top: 0;
    left: var(--gutter);
    right: var(--gutter);
    border-top: 1px dashed var(--rule);
  }
  .filed-label {
    font-weight: 600;
    color: var(--text-3);
  }
  .filed-cat {
    display: inline-flex;
    gap: 8px;
    font-family: var(--font-serif), Georgia, serif;
    font-size: 23px;
    color: var(--ink);
    transition: color 0.25s;
  }
  .filed-cat:hover {
    color: var(--accent);
  }

  /* The way on: two notes on scraps of paper. */
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    margin-top: clamp(44px, 6vw, 72px);
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 20px 18px;
    transition: rotate 0.4s var(--ease), box-shadow 0.3s;
  }
  .pager-link::before {
    width: 56px;
  }
  .pager-link:hover {
    rotate: 0deg;
    box-shadow: var(--lift-high);
  }
  .pager-next {
    text-align: right;
    align-items: flex-end;
  }
  .pager-link .hand {
    font-weight: 600;
    font-size: 22px;
  }
  .pager-title {
    font-family: var(--font-serif), Georgia, serif;
    font-size: 21px;
    line-height: 1.2;
    color: var(--print-ink);
  }

  @media (max-width: 620px) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pager-next {
      text-align: left;
      align-items: flex-start;
    }

    /* On a phone, one above the other: side by side, each would be too
       small to make out a pencil line. */
    .plates {
      flex-direction: column;
      gap: var(--s7);
      max-width: none;
    }
    .plates.plates--lone {
      width: 100%;
    }
    .plate {
      flex: none;
      width: min(100%, calc(var(--fit-h) * var(--r-plate)));
      margin-inline: auto;
    }
  }
</style>
