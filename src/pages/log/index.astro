---
import Base from '../../layouts/Base.astro';
import Frame from '../../components/Frame.astro';
import Scribble from '../../components/Scribble.astro';
import { allEntries, tilt } from '../../lib/entries';
import { categoryBySlug } from '../../data/categories';
import { url, shortDate } from '../../lib/site';

const entries = await allEntries();

// Group into years so a long archive reads as a run of seasons rather than
// one undifferentiated list.
const years = [...new Set(entries.map((e) => e.data.date.getUTCFullYear()))].sort((a, b) => b - a);
const byYear = years.map((year) => ({
  year,
  items: entries.filter((e) => e.data.date.getUTCFullYear() === year),
}));
---

<Base title="Log" description="Everything, newest first.">
  <div class="wrap head">
    <p class="kicker">The whole log</p>
    <h1>{entries.length} {entries.length === 1 ? 'entry' : 'entries'}, newest first.</h1>
    <Scribble />
  </div>

  {
    byYear.map(({ year, items }) => (
      <section class="year-block" aria-labelledby={`y${year}`}>
        <div class="wrap year-head">
          <h2 class="hand year" id={`y${year}`}>{year}</h2>
          <span class="mono year-count">
            {items.length} {items.length === 1 ? 'ENTRY' : 'ENTRIES'}
          </span>
        </div>

        <ol class="wrap list">
          {items.map((entry) => (
            <li>
              <a href={url(`/log/${entry.id}/`)}>
                <span class="thumb print" style={`--r:${tilt(entry.id, 5)}deg`}>
                  <Frame
                    image={entry.data.image}
                    alt=""
                    category={entry.data.category}
                    crop
                    class="is-small"
                    widths={[128, 256]}
                    sizes="64px"
                  />
                </span>

                <span class="body">
                  <span class="mono meta">
                    {shortDate(entry.data.date)}
                    <span class="dot" aria-hidden="true">
                      ·
                    </span>
                    {categoryBySlug(entry.data.category)?.name ?? entry.data.category}
                  </span>
                  <span class="title">{entry.data.title}</span>
                  <span class="blurb">{entry.data.blurb}</span>
                </span>

                <span class="go hand" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</Base>

<style>
  .head {
    padding-top: clamp(28px, 5vw, 46px);
  }
  .head .kicker {
    margin: 0 0 var(--s4);
  }
  h1 {
    font-size: clamp(34px, 5vw, 54px);
    line-height: 1.02;
    max-width: 16ch;
  }

  .year-block {
    margin-top: var(--s7);
  }

  .head,
  .year-head,
  .list {
    max-width: 900px;
  }

  .year-head {
    display: flex;
    align-items: baseline;
    gap: var(--s4);
  }
  .year {
    margin: 0;
    font-size: 34px;
    font-weight: 700;
    rotate: -2deg;
  }
  .year-count {
    font-size: 10.5px;
    letter-spacing: 0.13em;
    color: var(--text-3);
  }
  /* The rule runs from the year to the right margin, in pencil. */
  .year-head::after {
    content: '';
    flex: 1;
    border-top: 1px dashed var(--rule);
  }

  .list {
    list-style: none;
    margin: 0 auto;
  }
  .list li + li {
    border-top: 1px dashed var(--rule-soft);
  }

  .list a {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) 28px;
    gap: var(--s5);
    align-items: center;
    padding: var(--s5) var(--s2);
    transition: translate 0.35s var(--ease);
  }
  .list a:hover {
    translate: 6px 0;
  }

  /* A small print, turned as it lies; picking it up straightens it. */
  .thumb {
    display: block;
    padding: 4px;
    transition: rotate 0.4s var(--ease), box-shadow 0.3s;
  }
  .thumb::before {
    display: none;
  }
  .list a:hover .thumb {
    rotate: 0deg;
    box-shadow: var(--lift-high);
  }

  .body {
    display: block;
    min-width: 0;
  }
  .meta {
    display: block;
    font-weight: 500;
    font-size: 10.5px;
    letter-spacing: 0.13em;
    color: var(--text-3);
  }
  .dot {
    margin-inline: 6px;
  }
  .title {
    display: block;
    margin-top: 5px;
    font-family: var(--font-serif), Georgia, serif;
    font-size: clamp(22px, 2.4vw, 28px);
    line-height: 1.14;
    transition: color 0.25s;
  }
  .list a:hover .title {
    color: var(--accent);
  }
  .blurb {
    display: block;
    margin-top: 6px;
    max-width: 64ch;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-3);
  }

  .go {
    justify-self: end;
    font-size: 28px;
    transition: translate 0.3s var(--ease);
  }
  .list a:hover .go {
    translate: 6px 0;
  }

  @media (max-width: 680px) {
    .list a {
      grid-template-columns: 56px minmax(0, 1fr);
      gap: var(--s4);
      align-items: start;
    }
    .go {
      display: none;
    }
  }
</style>
