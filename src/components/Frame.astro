---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CategorySlug } from '../data/categories';

interface Props {
  image?: ImageMetadata;
  alt?: string;
  /** Pencilled on the frame when there is no picture yet. */
  slot?: string;
  category: CategorySlug;
  /** CSS aspect-ratio, e.g. "4 / 5". Empty frames always take it. A real
   *  picture keeps its own proportions unless `crop` is set. */
  ratio?: string;
  /** Force `ratio` on a real picture too, centre-cropping it. Used where the
   *  frame is one card of many and the row has to stay a row. */
  crop?: boolean;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  image,
  alt = '',
  slot = 'no image yet',
  category,
  ratio = '4 / 5',
  crop = false,
  widths = [340, 680, 1020],
  sizes = '(max-width: 860px) 92vw, 340px',
  loading = 'lazy',
  class: className,
} = Astro.props;

// A card keeps the given ratio so a table of them stays tidy — a thumbnail is
// allowed to be a crop. Everywhere there is room to show the picture whole
// (an entry's own page) it keeps its proportions, and nothing that was
// framed or drawn is thrown away.
const frameRatio = image && !crop ? `${image.width} / ${image.height}` : ratio;
---

<div
  class:list={['frame', className]}
  data-pattern={image ? undefined : category}
  style={`--ratio:${frameRatio}`}
>
  {
    image ? (
      <Image src={image} alt={alt} widths={widths} sizes={sizes} loading={loading} draggable="false" />
    ) : (
      <span class="frame-slot">{slot}</span>
    )
  }
</div>

<style>
  /* ── The empty frame ──────────────────────────────────────────────────────
     Most of this archive has no picture attached yet, so "no image" is a
     state the design has to carry rather than apologise for. Each category
     is shaded its own way — scan lines for film, cross-hatch for pencil,
     ruled lines for essays, graph paper for the bench, loose diagonals for
     the drawer — so an empty table still reads as five different habits
     instead of a row of identical grey boxes. A frame always sits on a
     print, so it takes the print's colours, not the page's. */
  .frame {
    --frame-line: rgb(42 43 46 / 15%);
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background-color: var(--print-ground);
    background-image: var(--frame-pattern, none);
    display: grid;
    place-items: center;
  }

  /* Pinned to the frame's edges rather than left as a grid item: in the
     grid, a picture taller than the frame's ratio grows the row to its own
     height and the frame then shows only its top. */
  .frame :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* Film: scan lines. */
  [data-pattern='photography'] {
    --frame-pattern: repeating-linear-gradient(0deg, var(--frame-line) 0 1px, transparent 1px 6px);
  }
  /* Pencil: cross-hatch. */
  [data-pattern='drawing'] {
    --frame-pattern: repeating-linear-gradient(45deg, var(--frame-line) 0 1px, transparent 1px 8px),
      repeating-linear-gradient(-45deg, var(--frame-line) 0 1px, transparent 1px 8px);
  }
  /* Essays: ruled lines. */
  [data-pattern='essays'] {
    --frame-pattern: repeating-linear-gradient(0deg, var(--frame-line) 0 1px, transparent 1px 14px);
  }
  /* The bench: graph paper. */
  [data-pattern='electronics'] {
    --frame-pattern: repeating-linear-gradient(0deg, var(--frame-line) 0 1px, transparent 1px 11px),
      repeating-linear-gradient(90deg, var(--frame-line) 0 1px, transparent 1px 11px);
  }
  /* The drawer: loose diagonals. */
  [data-pattern='found'] {
    --frame-pattern: repeating-linear-gradient(52deg, var(--frame-line) 0 1px, transparent 1px 13px);
  }

  /* What will go here, pencilled on a scrap of the print's paper. It is real
     information ("film scan · 4:5"), so it clears 4.5:1 on that scrap. */
  .frame-slot {
    position: relative;
    max-width: 88%;
    padding: 2px 10px;
    rotate: -3deg;
    background: var(--print);
    font-family: var(--font-hand), cursive;
    font-weight: 600;
    font-size: 20px;
    line-height: 1.25;
    text-align: center;
    text-transform: lowercase;
    color: var(--print-ink-3);
  }

  /* Thumbnails have no room for a caption. */
  .frame.is-small .frame-slot {
    display: none;
  }
</style>
