---
import Frame from './Frame.astro';
import { url, shortDate } from '../lib/site';
import { categoryBySlug } from '../data/categories';
import { tilt, type Entry } from '../lib/entries';

interface Props {
  entry: Entry;
  /** Its place on the table, for the order the cards are dropped in. */
  index?: number;
}
const { entry, index = 0 } = Astro.props;
const { title, date, category, image, imageAlt, slot } = entry.data;
const categoryName = categoryBySlug(category)?.name ?? category;

// Where it landed: its turn, its tape's turn, and how far it slid from its
// place in the grid. All from its id, so it lies the same way on every page.
const lie = [
  `--r:${tilt(entry.id, 6)}deg`,
  `--tr:${tilt(entry.id, 5, 'tape')}deg`,
  `--ox:${tilt(entry.id, 14, 'x')}px`,
  `--oy:${tilt(entry.id, 16, 'y')}px`,
  `--i:${index}`,
].join(';');
---

<a class="card print" href={url(`/log/${entry.id}/`)} data-category={category} style={lie} draggable="false">
  <Frame
    image={image}
    alt={imageAlt ?? ''}
    slot={slot}
    category={category}
    crop
    widths={[240, 480, 720]}
    sizes="(max-width: 560px) 46vw, 240px"
  />
  <span class="card-line mono">{shortDate(date)} · {categoryName}</span>
  <span class="card-title">{title}</span>
</a>

<style>
  .card {
    display: block;
    padding: 10px 10px 14px;
    translate: calc(var(--ox) * var(--scatter, 1) + var(--dx, 0px))
      calc(var(--oy) * var(--scatter, 1) + var(--dy, 0px));
    transition:
      translate 0.8s var(--ease),
      rotate 0.8s var(--ease),
      box-shadow 0.3s,
      opacity 0.5s,
      filter 0.5s;
    user-select: none;
    -webkit-user-select: none;
  }
  .card:hover,
  .card:focus-visible {
    box-shadow: var(--lift-high);
    rotate: calc(var(--r) * 0.4);
  }

  .card-line {
    display: block;
    margin-top: 10px;
    font-weight: 500;
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--print-ink-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .card-title {
    display: block;
    margin-top: 4px;
    font-family: var(--font-serif), Georgia, serif;
    font-size: 20px;
    line-height: 1.12;
    color: var(--print-ink);
  }

  @media (max-width: 560px) {
    .card {
      padding: 8px 8px 12px;
    }
    .card-title {
      font-size: 17px;
    }
  }
</style>
